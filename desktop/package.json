{
  "name": "project-analyzer-desktop",
  "productName": "ProjectAnalyzer",
  "version": "0.4.0",
  "description": "프로젝트 분석 시스템 (프로토타입)",
  "author": "project-analyzer",
  "private": true,
  "main": "main.mjs",
  "build": {
    "appId": "local.project-analyzer",
    "productName": "ProjectAnalyzer",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "app/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "extraFiles": [
      {
        "from": "../docs/사용방법.txt",
        "to": "README.txt"
      }
    ],
    "compression": "maximum",
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.1"
  },
  "dependencies": {
    "mariadb": "^3.5.4",
    "oracledb": "^6.10.0"
  }
}
