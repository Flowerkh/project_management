{
  "name": "project-analyzer",
  "productName": "프로젝트 분석 시스템",
  "version": "0.5.0",
  "description": "프로젝트 폴더를 불러와 DB 테이블·메뉴·화면·배치 관계를 정리하는 분석 도구 (프로토타입)",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "package": "node scripts/start-desktop.mjs --package",
    "typecheck": "tsc --noEmit",
    "analyze": "tsx scripts/analyze.ts",
    "test": "tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@types/node": "^22.10.2",
    "@types/oracledb": "^7.0.3",
    "diff": "^9.0.0",
    "esbuild": "^0.24.2",
    "iconv-lite": "^0.7.3",
    "mariadb": "^3.5.4",
    "oracledb": "^6.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "preact": "^10.25.4"
  }
}
